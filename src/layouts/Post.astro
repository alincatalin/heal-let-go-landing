---
import { ArrowLeft } from "@lucide/astro";
import Base from "./Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import PostCard from "../components/PostCard.astro";
import { formatDate, readTimeLabel } from "../lib/site";
import type { clusterLinks, seriesLinks } from "../lib/related";

interface Related {
  href: string;
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  readTime: string;
}

interface Props {
  kind: "Article" | "Guide";
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  updated?: Date;
  readTime: string;
  author: string;
  image?: string;
  related: Related[];
  slug?: string;
  cluster?: ReturnType<typeof clusterLinks>;
  cta?: { title: string; text: string };
  series?: ReturnType<typeof seriesLinks>;
  faq?: { question: string; answer: string }[];
  storePage?: string;
}

const { kind, title, excerpt, category, date, updated, readTime, author, image, related, slug, cluster, cta, series, faq = [], storePage } = Astro.props;
const seriesPath = (href: string) => href.replace(/\/$/, "");
const isCurrent = (href: string) => seriesPath(href) === seriesPath(Astro.url.pathname);
const site = Astro.site!.toString();
const url = new URL(Astro.url.pathname, site).toString();
const imageUrl = new URL(image ?? "/heal_let_them_go_app.png", site).toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: excerpt,
    image: imageUrl,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: { "@type": "Organization", name: author, url: site },
    publisher: {
      "@type": "Organization",
      name: "Heal",
      logo: { "@type": "ImageObject", url: new URL("/assets/logo.png", site).toString() },
    },
    mainEntityOfPage: { "@type": "WebPage", "@id": url },
    articleSection: category,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", site).toString() },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
  ...(faq.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: { "@type": "Answer", text: item.answer },
          })),
        },
      ]
    : []),
];
---

<Base
  title={title}
  description={excerpt}
  type="article"
  image={image}
  jsonLd={jsonLd}
  publishedTime={date}
  modifiedTime={updated}
  storeSource="blog"
  storeCampaign={slug}
  storePage={storePage}
>
  <SiteHeader />
  <main class="relative overflow-hidden">
    <article class="mx-auto px-4 py-12 sm:px-6 md:py-16">
      <div class="mx-auto max-w-[44rem]">
        <nav aria-label="Breadcrumb" class="mb-10">
          <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-semibold text-lavender transition-colors hover:text-ink">
            <ArrowLeft class="h-4 w-4" /> All articles
          </a>
        </nav>

        <header class="mb-12 space-y-6">
          <p class="eyebrow text-lavender">{kind === "Guide" ? `Guide · ${category}` : category}</p>
          <h1 class="text-[2.4rem] leading-[1.1] sm:text-5xl md:text-[3.4rem]">{title}</h1>
          <p class="quote text-xl leading-relaxed text-ink-soft md:text-[1.4rem]">{excerpt}</p>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-hairline pt-6 text-sm text-ink-muted">
            <span class="text-ink-soft">By {author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
            {
              updated && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>
                    Updated <time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time>
                  </span>
                </>
              )
            }
            <span aria-hidden="true">·</span>
            <span>{readTimeLabel(readTime)}</span>
          </div>
        </header>

        {
          series && series.length > 1 && (
            <nav aria-label="No contact day by day" class="mb-8 flex flex-wrap items-center gap-2 text-sm">
              <span class="eyebrow mr-2">No contact, day by day</span>
              {series.map((post) =>
                isCurrent(post.href) ? (
                  <span aria-current="page" class="rounded-full bg-dusk px-3.5 py-1.5 font-semibold text-white shadow-glow">{post.label}</span>
                ) : (
                  <a href={post.href} title={post.title} class="rounded-full border border-hairline bg-surface-1 px-3.5 py-1.5 text-ink-soft transition-colors hover:border-lavender/40 hover:text-ink">{post.label}</a>
                ),
              )}
            </nav>
          )
        }

        {
          cluster?.pillar && (
            <p class="card mb-10 px-6 py-4 text-[15px] text-ink-soft">
              Part of our {cluster.name.toLowerCase()} guide. Start with{" "}
              <a href={cluster.pillar.href} class="text-lavender underline decoration-lavender/40 underline-offset-4">{cluster.pillar.title}</a>.
            </p>
          )
        }

        <div class="prose-heal">
          <slot />
        </div>

        {
          cluster && (cluster.pillar || cluster.posts.length > 0) && (
            <nav aria-labelledby="cluster-heading" class="card-raised mt-14 p-7">
              <h2 id="cluster-heading" class="mb-4 text-2xl">
                {cluster.isPillar ? `Everything in our ${cluster.name.toLowerCase()} guide` : `More on ${cluster.name.toLowerCase()}`}
              </h2>
              <ul class="divide-y divide-hairline">
                {cluster.pillar && (
                  <li>
                    <a href={cluster.pillar.href} class="block py-3 text-[15px] text-lavender hover:text-ink">{cluster.pillar.title}</a>
                  </li>
                )}
                {cluster.posts.map((post) => (
                  <li>
                    <a href={post.href} class="block py-3 text-[15px] text-lavender hover:text-ink">{post.title}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <aside class="mt-10 flex gap-4 rounded-[1.25rem] border border-[#f49aa7]/25 bg-[#f49aa7]/[0.06] p-5 text-sm leading-relaxed text-ink-soft">
          <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#f49aa7]" aria-hidden="true"></span>
          <span>
            Heal is not a substitute for professional help. If you're struggling, visit
            <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="text-[#f49aa7] underline underline-offset-4">findahelpline.com</a>
            to reach a local helpline.
          </span>
        </aside>
      </div>
    </article>

    <FinalCTA
      title={cta?.title ?? "Want support at 2am?"}
      text={cta?.text ?? "Heal: Let Them Go gives you an AI coach, a no-contact tracker and a place to vent instead of texting them."}
      matchDevice
    />

    {
      related.length > 0 && (
        <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
          <div class="space-y-8">
            <h2 class="text-3xl md:text-4xl">Keep reading</h2>
            <div class="grid gap-5 md:grid-cols-3">
              {related.map((post) => (
                <PostCard {...post} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Base>
