---
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/fraunces/opsz-italic.css";
import "@fontsource-variable/figtree/wght.css";
import "../styles/global.css";
import { APP_STORE_ID, SHOW_SMART_APP_BANNER } from "../lib/store";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  storeSource?: string;
  storeCampaign?: string;
  storePage?: string;
}

const {
  title,
  description,
  image = "/heal-og.png",
  type = "website",
  jsonLd = [],
  noindex = false,
  publishedTime,
  modifiedTime,
  storeSource = "landing",
  storeCampaign,
  storePage,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Heal" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Heal Blog" href="/blog/rss.xml" />
    <meta name="theme-color" content="#0c0a16" />
    {SHOW_SMART_APP_BANNER && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}

    <meta property="og:site_name" content="Heal: No Contact & Breakup" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@healapp" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>document.documentElement.classList.add("js");</script>
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="7154e013-7126-49fd-bee9-b2a9e1b2cfaa"></script>
  </head>
  <body class="min-h-screen bg-night text-ink font-sans" data-store-source={storeSource} data-store-campaign={storeCampaign} data-store-page={storePage}>
    <slot />
    <script>
      import { tagStoreLinks } from "../lib/store";
      import { trackStoreClicks } from "../lib/analytics";
      tagStoreLinks(document, window.location, navigator.userAgent);
      trackStoreClicks(document);

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.1 },
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
