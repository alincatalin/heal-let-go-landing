---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found - Heal" description="This page doesn't exist." noindex>
  <SiteHeader />
  <main class="container mx-auto px-4 py-32 text-center space-y-6">
    <p class="text-6xl font-bold text-primary">404</p>
    <h1 class="text-3xl font-bold">This page doesn't exist.</h1>
    <p class="text-muted-foreground">Maybe it moved. The good stuff is still here.</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn btn-lg btn-default">Go home</a>
      <a href="/blog/" class="btn btn-lg btn-outline">Read the blog</a>
    </div>
  </main>
  <Footer />
</Base>
