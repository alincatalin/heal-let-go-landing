---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found - Heal" description="This page doesn't exist." noindex>
  <SiteHeader />
  <main class="mx-auto max-w-2xl space-y-6 px-4 py-32 text-center">
    <p class="font-display text-8xl font-light text-lavender">404</p>
    <h1 class="text-4xl">This page doesn't exist.</h1>
    <p class="quote text-xl text-ink-soft">Maybe it moved. The good stuff is still here.</p>
    <div class="flex flex-col justify-center gap-3 pt-2 sm:flex-row">
      <a href="/" class="btn btn-lg btn-primary">Go home</a>
      <a href="/blog/" class="btn btn-lg btn-secondary">Read the blog</a>
    </div>
  </main>
  <Footer />
</Base>
