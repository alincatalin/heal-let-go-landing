---
import { ArrowRight } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import PostCard from "../../components/PostCard.astro";
import { articleUrl, getArticles, getGuides, guideUrl } from "../../lib/site";

const articles = await getArticles();
const guides = await getGuides();
const site = Astro.site!.toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Heal Blog",
    url: new URL("/blog/", site).toString(),
    description: "Honest, practical breakup recovery advice: no contact, the urge to text your ex, and the stages of healing.",
    blogPost: articles.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: new URL(articleUrl(post), site).toString(),
      datePublished: post.data.date.toISOString(),
    })),
  },
];
---

<Base
  title="Breakup Recovery Blog - Heal: Let Them Go"
  description="Honest, practical breakup recovery advice: no contact, the urge to text your ex, and the stages of healing. No toxic positivity."
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <header class="mx-auto mb-14 max-w-3xl space-y-5 text-center md:mb-20">
        <p class="eyebrow text-lavender">The Heal blog</p>
        <h1 class="text-5xl leading-[1.08] md:text-6xl">
          Breakup recovery, <span class="italic text-lavender">honestly</span>
        </h1>
        <p class="lede">
          Real advice for real heartbreak. No toxic positivity, just honest guidance from people who've been there.
        </p>
      </header>

      {
        guides.length > 0 && (
          <section class="mb-16 space-y-6" aria-labelledby="guides-heading">
            <h2 id="guides-heading" class="eyebrow">Guides</h2>
            {guides.map((guide) => (
              <a href={guideUrl(guide)} class="card-hearth group block p-8 transition-transform hover:-translate-y-0.5 md:p-10">
                <p class="eyebrow text-ember">Ultimate guide</p>
                <h3 class="mt-3 text-3xl leading-tight md:text-4xl">{guide.data.title}</h3>
                <p class="mt-3 max-w-3xl text-lg text-ink-soft">{guide.data.excerpt}</p>
                <span class="mt-6 inline-flex items-center gap-2 font-semibold text-ember">
                  Read the guide <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            ))}
          </section>
        )
      }

      <section class="space-y-6" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="eyebrow">All articles</h2>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            articles.map((post) => (
              <PostCard
                href={articleUrl(post)}
                title={post.data.title}
                excerpt={post.data.excerpt}
                category={post.data.category}
                date={post.data.date}
                readTime={post.data.readTime}
              />
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>
