---
import { ArrowRight } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import PostCard from "../../components/PostCard.astro";
import { articleUrl, getArticles, getGuides, guideUrl } from "../../lib/site";

const articles = await getArticles();
const guides = await getGuides();
const site = Astro.site!.toString();

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Heal Blog",
    url: new URL("/blog/", site).toString(),
    description: "Honest, practical breakup recovery advice: no contact, the urge to text your ex, and the stages of healing.",
    blogPost: articles.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: new URL(articleUrl(post), site).toString(),
      datePublished: post.data.date.toISOString(),
    })),
  },
];
---

<Base
  title="Breakup Recovery Blog - Heal: Let Them Go"
  description="Honest, practical breakup recovery advice: no contact, the urge to text your ex, and the stages of healing. No toxic positivity."
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[420px] bg-gradient-glow pointer-events-none"></div>
    <div class="container mx-auto px-4 py-16 relative">
      <header class="max-w-3xl mx-auto text-center space-y-4 mb-14">
        <h1 class="text-4xl md:text-6xl font-bold">
          Healing <span class="bg-gradient-primary bg-clip-text text-transparent">Wisdom</span>
        </h1>
        <p class="text-xl text-muted-foreground">
          Real advice for real heartbreak. No toxic positivity, just honest guidance from people who've been there.
        </p>
      </header>

      {
        guides.length > 0 && (
          <section class="max-w-6xl mx-auto mb-16 space-y-6" aria-labelledby="guides-heading">
            <h2 id="guides-heading" class="text-2xl font-bold">Guides</h2>
            {guides.map((guide) => (
              <a
                href={guideUrl(guide)}
                class="group block rounded-2xl border border-primary/30 bg-gradient-to-br from-primary/15 to-card p-8 transition-all hover:shadow-glow"
              >
                <span class="inline-block rounded-lg bg-primary/10 px-3 py-1 text-sm text-primary mb-4">Ultimate Guide</span>
                <h3 class="text-2xl md:text-3xl font-bold mb-3 group-hover:text-primary transition-colors">{guide.data.title}</h3>
                <p class="text-muted-foreground text-lg max-w-3xl mb-4">{guide.data.excerpt}</p>
                <span class="inline-flex items-center gap-2 text-primary font-medium">
                  Read the guide <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            ))}
          </section>
        )
      }

      <section class="max-w-6xl mx-auto space-y-6" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="text-2xl font-bold">Articles</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            articles.map((post) => (
              <PostCard
                href={articleUrl(post)}
                title={post.data.title}
                excerpt={post.data.excerpt}
                category={post.data.category}
                date={post.data.date}
                readTime={post.data.readTime}
              />
            ))
          }
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Base>
