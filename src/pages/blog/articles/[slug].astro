---
import { render } from "astro:content";
import Post from "../../../layouts/Post.astro";
import { getArticles, type Article } from "../../../lib/site";
import { clusterLinks, relatedArticles } from "../../../lib/related";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry, articles } }));
}

interface Props {
  entry: Article;
  articles: Article[];
}

const { entry, articles } = Astro.props;
const { Content } = await render(entry);
---

<Post
  kind="Article"
  {...entry.data}
  slug={entry.id}
  related={relatedArticles({ id: entry.id, ...entry.data }, articles)}
  cluster={clusterLinks({ id: entry.id, ...entry.data }, articles)}
>
  <Content />
</Post>
