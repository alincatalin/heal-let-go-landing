---
import { ArrowLeft, ArrowRight, RotateCcw } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import MoreTools from "../../components/MoreTools.astro";
import StoreButtons from "../../components/StoreButtons.astro";
import { appStorePage } from "../../lib/store";

const title = "How Long Should No Contact Last? Free 1-Minute Calculator";
const description =
  "How long should no contact last for you? Answer 5 quick questions about your relationship and get a number of days, a target date and why, from 30 to 90 days or more.";

// Each option sets or adds days; flags switch the answer to low contact (kids, work) or open-ended (abuse).
const questions = [
  {
    id: "length",
    text: "How long were you together?",
    options: [
      { label: "Less than 3 months, or it was never official", days: 30 },
      { label: "3 to 12 months", days: 60 },
      { label: "1 to 3 years", days: 60 },
      { label: "More than 3 years", days: 90 },
    ],
  },
  {
    id: "ties",
    text: "Do you have to stay in touch for anything?",
    options: [
      { label: "No", days: 0 },
      { label: "We work or study together", days: 0, flag: "low" },
      { label: "We share children", days: 0, flag: "low" },
      { label: "A lease, money or a pet we still need to sort out", days: 0, flag: "sort" },
    ],
  },
  {
    id: "pattern",
    text: "Which sounds most like the relationship?",
    options: [
      { label: "Mostly good, it just ended", days: 0 },
      { label: "On and off: we broke up and got back together before", days: 30 },
      { label: "They cheated, or kept me guessing", days: 30 },
      { label: "They controlled, scared or hurt me", days: 0, flag: "safety" },
    ],
  },
  {
    id: "goal",
    text: "What do you want from no contact?",
    options: [
      { label: "To get over them", days: 0 },
      { label: "I'm not sure yet", days: 0 },
      { label: "Honestly, I hope we get back together", days: 0, flag: "back" },
    ],
  },
  {
    id: "now",
    text: "How are you doing right now?",
    options: [
      { label: "Mostly okay, with bad moments", days: 0 },
      { label: "Up and down every day", days: 0 },
      { label: "Barely getting through the day", days: 30, flag: "support" },
    ],
  },
];

const faq = [
  {
    question: "How long should no contact last?",
    answer:
      "At least 30 days, and 60 to 90 days if the relationship was long, on and off, or you're still struggling. Thirty days is the common minimum because the sharpest urges usually ease within the first month. If you share children or a workplace, aim for low contact (logistics only) instead.",
  },
  {
    question: "Is 30 days of no contact enough?",
    answer:
      "For a short relationship, often yes. For a relationship of a year or more, or one that kept starting again, 30 days is usually where it starts to get easier rather than where it ends. Check in with yourself at day 30 and decide whether to extend.",
  },
  {
    question: "Does no contact make them come back?",
    answer:
      "Sometimes an ex reaches out during no contact, but that isn't what it's for. No contact gives you the distance to see the relationship clearly. If they do come back, you'll be in a better place to decide whether you want that.",
  },
  {
    question: "What if we have kids together?",
    answer:
      "Then full no contact isn't realistic. Use low contact: keep messages to the children and logistics, use one channel, reply in daylight, and keep feelings for your journal or a friend.",
  },
];

const site = Astro.site!.toString();
const url = new URL("/tools/how-long-no-contact/", site).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "How Long Should No Contact Last? Calculator",
    url,
    description,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "Any",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@type": "Organization", "@id": `${site}#organization`, name: "Heal", url: site },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site },
      { "@type": "ListItem", position: 2, name: "Free Tools", item: new URL("/tools/", site).toString() },
      { "@type": "ListItem", position: 3, name: "How Long Should No Contact Last?", item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd} storeSource="tool" storeCampaign="how-long-no-contact" storePage={appStorePage("no-contact")}>
  <SiteHeader />
  <main class="relative overflow-hidden">
    <div class="mx-auto max-w-[44rem] px-4 py-12 sm:px-6 md:py-16">
      <header class="mb-10 space-y-5 text-center">
        <p class="eyebrow text-lavender">Free · 5 questions · 1 minute</p>
        <h1 class="text-[2.4rem] leading-[1.1] sm:text-5xl">How long should no contact last?</h1>
        <p class="lede">Five quick questions about your relationship. Get a number of days, a target date, and why.</p>
      </header>

      <div id="calc" class="card-raised scroll-mt-24 p-6 md:p-9">
        <div class="mb-6 flex items-center justify-between gap-4 text-sm text-ink-muted">
          <span id="calc-count" aria-live="polite">Question 1 of {questions.length}</span>
          <button id="calc-back" type="button" class="btn btn-quiet h-9 px-3 text-sm" hidden><ArrowLeft /> Back</button>
        </div>
        <div class="mb-8 h-1.5 overflow-hidden rounded-full bg-surface-3" aria-hidden="true">
          <div id="calc-bar" class="h-full rounded-full bg-[#a48bf7] transition-all duration-300" style={`width: ${100 / questions.length}%`}></div>
        </div>
        <form id="calc-form">
          {
            questions.map((q, qi) => (
              <fieldset data-step={qi} hidden={qi > 0} class="space-y-3">
                <legend class="mb-5 font-display text-2xl leading-snug text-ink md:text-[1.7rem]">{q.text}</legend>
                {q.options.map((o, oi) => (
                  <label class="calc-option card card-link flex cursor-pointer items-center gap-4 px-5 py-4 text-[16px] text-ink-soft">
                    <input type="radio" name={q.id} value={oi} data-days={o.days} data-flag={"flag" in o ? o.flag : undefined} class="h-4 w-4 shrink-0 accent-[#a48bf7]" />
                    <span>{o.label}</span>
                  </label>
                ))}
              </fieldset>
            ))
          }
        </form>

        <section id="result" hidden class="space-y-5" aria-live="polite">
          <p class="eyebrow text-lavender">Your answer</p>
          <h2 id="r-title" class="text-3xl leading-tight md:text-4xl"></h2>
          <p id="r-date" class="text-lg text-ink"></p>
          <p id="r-text" class="text-[17px] leading-relaxed text-ink-soft"></p>
          <ul id="r-why" class="space-y-2 text-[15px] text-ink-soft"></ul>
          <div class="flex flex-wrap gap-3">
            <a id="r-counter" href="/tools/no-contact-counter/" class="btn btn-primary">Start my count <ArrowRight /></a>
            <a href="/tools/no-contact-challenge/" class="btn btn-quiet">Do it as a 30-day challenge</a>
          </div>
          <div id="r-app" class="rounded-[1.25rem] border border-[#a48bf7]/25 bg-surface-1 p-5" data-cta="tool">
            <p class="text-[15px] font-semibold text-ink">Getting to the date is the hard part</p>
            <p class="mt-1 text-[15px] leading-relaxed text-ink-soft">
              Heal counts the days for you and keeps your total if you slip. When the urge hits before the date, there's an
              SOS button and a chat that looks like theirs but never sends. Free to start.
            </p>
            <StoreButtons matchDevice class="mt-4" />
          </div>
          <button type="button" id="restart" class="btn btn-quiet h-10 px-3 text-sm"><RotateCcw /> Start again</button>
        </section>
      </div>

      <div class="prose-heal mt-16">
        <h2>How long should no contact last?</h2>
        <p>
          At least 30 days. For most breakups, 60 to 90 days works better, and longer if the relationship was long, kept
          starting again, or you're still struggling. If you share children or a job, full no contact isn't realistic:
          use low contact, which means logistics only. The calculator above weighs those things for your situation.
        </p>
        <table>
          <thead><tr><th>Your situation</th><th>Suggested no contact</th></tr></thead>
          <tbody>
            <tr><td>Short relationship or situationship (under 3 months)</td><td>30 days</td></tr>
            <tr><td>3 months to 3 years</td><td>60 days</td></tr>
            <tr><td>More than 3 years</td><td>90 days</td></tr>
            <tr><td>On and off, or they cheated</td><td>Add 30 days (up to 90 or more)</td></tr>
            <tr><td>You're barely getting through the day</td><td>Add 30 days, and talk to someone</td></tr>
            <tr><td>Shared children or a workplace</td><td>Low contact: logistics only, no end date</td></tr>
            <tr><td>They controlled, scared or hurt you</td><td>No end date. Keep contact closed and get support</td></tr>
          </tbody>
        </table>

        <h2>Why 30, 60 or 90 days?</h2>
        <p>
          Feelings after a breakup ease over weeks, not days, and not in a straight line. People followed daily for a
          month after a breakup felt less sad and angry overall, with bad days still mixed in (<a
            href="https://doi.org/10.1111/j.1350-4126.2005.00112.x">Sbarra and Emery, 2005</a>). Early on, rejection also
          activates the brain's reward and craving systems (<a href="https://doi.org/10.1152/jn.00784.2009">Fisher et al.,
          2010</a>), which is why the pull to reach out feels so strong at first. Thirty days gets you past the sharpest
          part. Sixty to ninety gives new habits time to set; in one study, a new daily habit took a median of 66 days to
          become automatic (<a href="https://doi.org/10.1002/ejsp.674">Lally et al., 2010</a>).
        </p>
        <p>
          The number matters less than having one. A clear end date stops the daily bargaining ("just one message
          won't hurt"). When you reach it, decide again. For the full method, read the{" "}
          <a href="/blog/articles/no-contact-rule-guide/">no contact rule guide</a>, and see what to expect along the way in{" "}
          <a href="/blog/articles/no-contact-day-by-day/">no contact day by day</a>.
        </p>

        <h2>FAQ: How long no contact should last</h2>
        {
          faq.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))
        }

        <h2>Sources</h2>
        <ul>
          <li>Sbarra, D. A., and Emery, R. E. (2005). The emotional sequelae of nonmarital relationship dissolution. <em>Personal Relationships</em>, 12(2), 213 to 232.</li>
          <li>Fisher, H. E., Brown, L. L., Aron, A., Strong, G., and Mashek, D. (2010). Reward, addiction, and emotion regulation systems associated with rejection in love. <em>Journal of Neurophysiology</em>, 104(1), 51 to 60.</li>
          <li>Lally, P., van Jaarsveld, C. H. M., Potts, H. W. W., and Wardle, J. (2010). How are habits formed: Modelling habit formation in the real world. <em>European Journal of Social Psychology</em>, 40(6), 998 to 1009.</li>
        </ul>
      </div>

      <aside class="mt-12 flex gap-4 rounded-[1.25rem] border border-[#f49aa7]/25 bg-[#f49aa7]/[0.06] p-5 text-sm leading-relaxed text-ink-soft">
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#f49aa7]" aria-hidden="true"></span>
        <span>
          This calculator is not a substitute for professional help. If you feel unsafe, or you're struggling to get
          through the day, visit{" "}
          <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="text-[#f49aa7] underline underline-offset-4">findahelpline.com</a>{" "}
          to reach a local helpline.
        </span>
      </aside>
    </div>
  </main>
  <MoreTools current="/tools/how-long-no-contact/" />
  <Footer />
</Base>

<script>
  type Umami = { track: (event: string, data?: Record<string, string>) => void };
  const form = document.getElementById("calc-form") as HTMLFormElement;
  const steps = [...form.querySelectorAll<HTMLFieldSetElement>("fieldset[data-step]")];
  const count = document.getElementById("calc-count")!;
  const bar = document.getElementById("calc-bar")!;
  const back = document.getElementById("calc-back")!;
  const result = document.getElementById("result")!;
  const $ = (id: string) => document.getElementById(id)!;
  let current = 0;

  function show(index: number) {
    current = index;
    steps.forEach((step, i) => (step.hidden = i !== index));
    result.hidden = true;
    form.hidden = false;
    count.textContent = `Question ${index + 1} of ${steps.length}`;
    bar.style.width = `${((index + 1) / steps.length) * 100}%`;
    back.hidden = index === 0;
  }

  function finish() {
    const checked = [...form.querySelectorAll<HTMLInputElement>("input:checked")];
    const flags = new Set(checked.map((i) => i.dataset.flag).filter(Boolean));
    const days = Math.min(120, checked.reduce((sum, i) => sum + Number(i.dataset.days), 0));
    const target = new Date();
    target.setDate(target.getDate() + days);
    const fmt = (d: Date) => d.toLocaleDateString(undefined, { weekday: "long", month: "long", day: "numeric", year: "numeric" });
    const why: string[] = [];
    const answer = (id: string) => (form.elements.namedItem(id) as RadioNodeList).value;
    if (answer("length") === "3") why.push("A long relationship leaves more habits and routines to unwind.");
    if (answer("pattern") === "1") why.push("On-and-off relationships restart easily. A longer stretch breaks the cycle.");
    if (answer("pattern") === "2") why.push("After cheating or mixed signals, it takes longer to trust your own read again.");
    if (flags.has("support")) why.push("You're having a hard time, so give yourself more room, and please talk to someone you trust.");
    if (flags.has("back")) why.push("No contact isn't a way to win them back, but the distance will help you decide what you really want if they do reach out.");
    if (flags.has("sort")) why.push("Sort the lease, money or pet first, in one or two practical messages, then start the count.");

    let title = `${days} days of no contact`;
    let date = `Your target: ${fmt(target)}, if you start today.`;
    let text = "Count from the last time you contacted them. When you reach the date, check in with yourself and decide whether to keep going.";
    let result_id = String(days);
    if (flags.has("safety")) {
      title = "No end date. Keep contact closed.";
      date = "";
      text = "When a relationship involved control, fear or harm, no contact is about your safety, not a timeline. Block where you need to, tell someone you trust, and get support. If you're in danger, contact local emergency services.";
      why.length = 0;
      why.push("Find a local helpline at findahelpline.com, or a domestic abuse service in your country.");
      result_id = "safety";
    } else if (flags.has("low")) {
      title = "Low contact, not no contact";
      date = `Treat ${fmt(target)} as your first check-in.`;
      text = "You can't fully cut contact with someone you share children or a workplace with. Keep it to logistics: one channel, short messages, daylight hours, no small talk. Everything else goes to your journal or a friend.";
      result_id = "low";
    }
    $("r-title").textContent = title;
    $("r-date").textContent = date;
    $("r-date").hidden = !date;
    $("r-text").textContent = text;
    $("r-why").replaceChildren(
      ...why.map((w) => {
        const li = document.createElement("li");
        li.textContent = `• ${w}`;
        return li;
      }),
    );
    ($("r-counter") as HTMLAnchorElement).hidden = result_id === "safety";
    $("r-app").hidden = result_id === "safety";
    form.hidden = true;
    back.hidden = true;
    count.textContent = "Your result";
    bar.style.width = "100%";
    result.hidden = false;
    $("calc").scrollIntoView({ behavior: "smooth", block: "start" });
    (window as unknown as { umami?: Umami }).umami?.track("Tool Completed", { tool: "how-long-no-contact", result: result_id });
  }

  form.addEventListener("change", () => {
    window.setTimeout(() => (current < steps.length - 1 ? show(current + 1) : finish()), 220);
  });
  back.addEventListener("click", () => show(Math.max(0, current - 1)));
  $("restart").addEventListener("click", () => {
    form.reset();
    show(0);
  });
</script>

<style>
  .calc-option:has(input:checked) {
    border-color: rgba(164, 139, 247, 0.55);
    color: var(--ink);
  }
  .calc-option:has(input:focus-visible) {
    outline: 2px solid var(--lavender-hex);
    outline-offset: 2px;
  }
</style>
