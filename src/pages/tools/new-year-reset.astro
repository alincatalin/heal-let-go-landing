---
import { ArrowRight, Copy } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import StoreButtons from "../../components/StoreButtons.astro";

const title = "New Year After a Breakup: Free 4-Week 2027 Reset Plan";
const description =
  "Start the new year after a breakup with a free 4-week plan: quiet their corner of your phone, get through the urges, make sense of it, and rebuild. Built from four quick questions.";

// Every week points at something the Heal app already does (checked against the app on 2026-11-17), so the plan
// never promises a feature that isn't there. "Heal+" is the paid tier; everything else is free.
const weeks = [
  {
    name: "Week 1: Quiet their corner",
    does: "Start your no contact count, write your reasons list, and mute or archive them on every app.",
    where: "The no contact clock, and Today's steps \"Write your reasons list\" and \"Quiet their corner of your phone\".",
    cost: "Free",
  },
  {
    name: "Week 2: Get through the urges",
    does: "When the urge hits, breathe, then write the text where it can't send. Pick up to three people to text instead.",
    where: "SOS, unsent texts and your people. After a few logged urges, Heal learns your hardest hour and checks in before it.",
    cost: "Free. An AI reality check on every unsent text is Heal+.",
  },
  {
    name: "Week 3: Make sense of it",
    does: "One short writing prompt a day, and someone to talk it through with at 2am.",
    where: "Today's step, the journal and the AI coach.",
    cost: "Free with 5 coach messages a day. Heal+ adds far more messages and the full library.",
  },
  {
    name: "Week 4: Rebuild",
    does: "Check in each day, read back your week, and reach the 30-day milestone.",
    where: "Check-ins, the weekly recap and the milestone ladder (1, 3, 7, 14, 30 days).",
    cost: "Free. Heal's written read of your week and backup to a new phone are Heal+.",
  },
];

// The quiz uses the app's own onboarding answers, so the plan matches what Heal shows after install.
const ended = [
  { id: "week", label: "Less than a week ago" },
  { id: "month", label: "1 to 4 weeks ago" },
  { id: "quarter", label: "1 to 3 months ago" },
  { id: "half", label: "3 to 6 months ago" },
  { id: "longer", label: "More than 6 months ago" },
];
const situations = [
  { id: "none", label: "No, no contact" },
  { id: "limited", label: "Yes: kids, work or friends" },
  { id: "unsure", label: "Not sure yet" },
];
const hardest = [
  { id: "texting", label: "Wanting to text them" },
  { id: "socials", label: "Checking their socials" },
  { id: "nights", label: "Nights" },
  { id: "overthinking", label: "Overthinking" },
  { id: "seeing", label: "Seeing them" },
];
const dreaded = ["Christmas Eve", "Christmas Day", "New Year's Eve", "January 1", "The days after"];

// Week 2 leads with the tool that fits what's hardest.
const urgeLines: Record<string, string> = {
  texting: "When you want to text them, write it in Heal's unsent texts first. It looks like your chat, but it never sends.",
  socials: "Do Heal's \"Quiet their corner of your phone\" step on every app: mute, archive, unfollow.",
  nights: "Turn on Heal's heads-up before your hardest hour, and charge your phone outside the bedroom.",
  overthinking: "When the loop starts, write one page in the journal, then talk it through with Heal's coach.",
  seeing: "Before you'll see them, pick your exit and use Heal's shared-friends script.",
};

const faq = [
  {
    question: "How do I start the new year after a breakup?",
    answer:
      "Pick one clear goal for January, like no contact for 30 days, and make it small enough to keep: quiet their corner of your phone in week 1, plan for the urges in week 2, make sense of it in week 3, and rebuild in week 4. The 2027 Reset Plan lays out those four weeks for you.",
  },
  {
    question: "Is the 2027 Reset Plan free?",
    answer:
      "Yes. The plan is free, and most of it runs on the free Heal app. Heal+ adds more AI coach messages, a reality check on every unsent text, the full library, a written read of your week and backup.",
  },
  {
    question: "What if I still have to talk to my ex?",
    answer:
      "Choose limited contact when you build the plan. Heal has short scripts for kids, work, shared friends and returning things, and contact you mark as necessary doesn't reset your count.",
  },
  {
    question: "When should I start?",
    answer:
      "Any day. January 1 is a natural start, but so is the day after a slip. If you're already doing the Holiday No Contact Challenge, the plan picks up where it ends.",
  },
];

const site = Astro.site!.toString();
const url = new URL("/tools/new-year-reset/", site).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "The 2027 Reset Plan: four weeks to start the new year after a breakup",
    description,
    totalTime: "P28D",
    step: weeks.map((w, i) => ({ "@type": "HowToStep", position: i + 1, name: w.name, text: w.does })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site },
      { "@type": "ListItem", position: 2, name: "Free Tools", item: new URL("/tools/", site).toString() },
      { "@type": "ListItem", position: 3, name: "2027 Reset Plan", item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<Base title={title} description={description} jsonLd={jsonLd} storeSource="tool" storeCampaign="new-year-reset">
  <SiteHeader />
  <main class="relative overflow-hidden">
    <div class="mx-auto max-w-[44rem] px-4 py-12 sm:px-6 md:py-16">
      <header class="mb-10 space-y-5 text-center">
        <p class="eyebrow text-lavender">Free · 4 weeks · from January 1 or any day</p>
        <h1 class="text-[2.4rem] leading-[1.1] sm:text-5xl">Your 2027 Reset Plan</h1>
        <p class="lede">
          A four-week plan for the new year after a breakup, built from four quick questions. Free, no sign-up, and nothing you
          pick is saved.
        </p>
      </header>

      <form id="reset-form" class="card-raised space-y-8 p-6 md:p-9" novalidate>
        <fieldset class="space-y-3">
          <legend class="mb-3 text-xl font-semibold text-ink">1. When did it end?</legend>
          <div class="flex flex-wrap gap-2">
            {ended.map((o, i) => (<label class="chip-option"><input type="radio" name="ended" value={o.id} class="sr-only" checked={i === 2} /><span>{o.label}</span></label>))}
          </div>
        </fieldset>
        <fieldset class="space-y-3">
          <legend class="mb-3 text-xl font-semibold text-ink">2. Do you still have to talk to them?</legend>
          <div class="flex flex-wrap gap-2">
            {situations.map((o, i) => (<label class="chip-option"><input type="radio" name="situation" value={o.id} class="sr-only" checked={i === 0} /><span>{o.label}</span></label>))}
          </div>
        </fieldset>
        <fieldset class="space-y-3">
          <legend class="mb-3 text-xl font-semibold text-ink">3. What's hardest right now?</legend>
          <div class="flex flex-wrap gap-2">
            {hardest.map((o, i) => (<label class="chip-option"><input type="radio" name="hardest" value={o.id} class="sr-only" checked={i === 0} /><span>{o.label}</span></label>))}
          </div>
        </fieldset>
        <fieldset class="space-y-3">
          <legend class="mb-3 text-xl font-semibold text-ink">4. Which day are you dreading most?</legend>
          <div class="flex flex-wrap gap-2">
            {dreaded.map((o, i) => (<label class="chip-option"><input type="radio" name="dreaded" value={o} class="sr-only" checked={i === 2} /><span>{o}</span></label>))}
          </div>
        </fieldset>
        <button type="submit" class="btn btn-primary w-full justify-center">Build my plan <ArrowRight /></button>
      </form>

      <section id="plan" class="mt-8 space-y-4" hidden aria-live="polite">
        <h2 class="text-center text-3xl leading-tight">Your 2027 Reset Plan</h2>
        <p id="plan-intro" class="text-center text-[17px] leading-relaxed text-ink-soft"></p>
        <ol id="plan-weeks" class="space-y-4"></ol>
        <p id="plan-dreaded" class="card-raised p-5 text-[16px] leading-relaxed text-ink-soft"></p>
        <div class="card-raised space-y-4 p-6 text-center md:p-8" data-cta="tool">
          <p class="eyebrow text-lavender">Run the plan in Heal</p>
          <p class="text-[17px] leading-relaxed text-ink-soft">
            Every step above is a screen in the Heal app: the clock, SOS, unsent texts, the coach, check-ins and weekly
            recaps. Free to start.
          </p>
          <StoreButtons matchDevice class="justify-center" />
          <p class="hidden text-sm text-ink-muted md:block">On a computer? Open this page on your phone to get the app there.</p>
        </div>
        <div class="text-center">
          <button type="button" id="copy-plan" class="btn btn-quiet"><Copy /> Copy my plan</button>
          <p id="msg" class="mt-2 text-sm text-ink-muted" hidden></p>
        </div>
      </section>

      <div class="prose-heal mt-16">
        <h2>How do you start the new year after a breakup?</h2>
        <p>
          Keep it to one goal and four small weeks. Quiet their corner of your phone first, then plan for the urges,
          then make sense of what happened, then rebuild your days around yourself. A clean start date helps:
          researchers call dates like January 1 "fresh start" moments, when people are more likely to begin a new habit
          (Dai, Milkman and Riis, 2014).
        </p>

        <h2>The four weeks</h2>
        <div class="not-prose space-y-4">
          {
            weeks.map((w) => (
              <section class="card-raised space-y-2 p-5">
                <h3 class="text-xl font-semibold text-ink">{w.name}</h3>
                <p class="text-[16px] leading-relaxed text-ink-soft">{w.does}</p>
                <p class="text-[15px] leading-relaxed text-ink-muted">
                  <span class="text-ink">In Heal:</span> {w.where}
                </p>
                <p class="text-[15px] leading-relaxed text-ink-muted">
                  <span class="text-ink">Cost:</span> {w.cost}
                </p>
              </section>
            ))
          }
        </div>

        <h2>What if the holidays went badly?</h2>
        <p>
          Then this is the plan for you. A slip over Christmas doesn't erase the days before it, and the count starts
          again from today. If it happened recently, read{" "}
          <a href="/blog/articles/i-broke-no-contact/">what to do if you broke no contact</a> first. If you're still in
          the <a href="/tools/holiday-challenge/">Holiday No Contact Challenge</a>, finish it: the plan picks up on
          January 2.
        </p>

        <h2>What if the urge to text them hits tonight?</h2>
        <p>
          Write it in our <a href="/tools/unsent-text/">unsent text tool</a> first. It looks like a chat with them, but
          nothing sends, and it asks what you're hoping they'll say.
        </p>

        <h2>FAQ: the 2027 Reset Plan</h2>
        {
          faq.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))
        }
      </div>

      <aside class="mt-12 flex gap-4 rounded-[1.25rem] border border-[#f49aa7]/25 bg-[#f49aa7]/[0.06] p-5 text-sm leading-relaxed text-ink-soft">
        <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#f49aa7]" aria-hidden="true"></span>
        <span>
          This plan is not a substitute for professional help. If you feel unsafe, visit{" "}
          <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="text-[#f49aa7] underline underline-offset-4">findahelpline.com</a>{" "}
          to reach a local helpline.
        </span>
      </aside>
    </div>
  </main>
  <Footer />
</Base>

<script is:inline type="application/json" id="reset-data" set:html={JSON.stringify({ weeks, urgeLines })} />

<script>
  type Umami = { track: (event: string, data?: Record<string, string>) => void };
  type Week = { name: string; does: string; where: string; cost: string };
  const { weeks, urgeLines } = JSON.parse(document.getElementById("reset-data")!.textContent!) as {
    weeks: Week[];
    urgeLines: Record<string, string>;
  };
  const track = (result: string) =>
    (window as unknown as { umami?: Umami }).umami?.track("Tool Completed", { tool: "new-year-reset", result });

  const form = document.getElementById("reset-form") as HTMLFormElement;
  const plan = document.getElementById("plan")!;
  const list = document.getElementById("plan-weeks")!;
  const intro = document.getElementById("plan-intro")!;
  const dreadedLine = document.getElementById("plan-dreaded")!;
  const msg = document.getElementById("msg")!;
  let planText = "";

  const pick = (name: string) => (form.querySelector(`input[name="${name}"]:checked`) as HTMLInputElement).value;

  function build() {
    const ended = pick("ended");
    const situation = pick("situation");
    const hardest = pick("hardest");
    const dreaded = pick("dreaded");

    // The app's own words for the first days (Phase.FIRST_DAYS) and for later phases.
    intro.textContent =
      ended === "week"
        ? "Everything hurts and nothing makes sense yet. Getting through each day is enough. Start week 1 today."
        : ended === "month"
          ? "Urges peak around now. Wanting to reach out is normal; acting on it is optional."
          : "Four small weeks, starting January 2 or any day you choose.";

    const extra: Record<number, string> = { 1: urgeLines[hardest] };
    if (situation === "limited") {
      extra[2] = "Keep messages to logistics. Heal has short scripts for kids, work and shared friends, and contact you mark as necessary doesn't reset your count.";
    }

    list.replaceChildren(
      ...weeks.map((w, i) => {
        const li = document.createElement("li");
        li.className = "card-raised space-y-2 p-5";
        const h = document.createElement("h3");
        h.className = "text-xl font-semibold text-ink";
        h.textContent = w.name;
        const does = document.createElement("p");
        does.className = "text-[16px] leading-relaxed text-ink-soft";
        does.textContent = extra[i] ? `${w.does} ${extra[i]}` : w.does;
        const where = document.createElement("p");
        where.className = "text-[15px] leading-relaxed text-ink-muted";
        where.textContent = `In Heal: ${w.where}`;
        li.append(h, does, where);
        return li;
      }),
    );

    dreadedLine.textContent = `Your hardest day is ${dreaded}. Plan that evening's last hour now: who you'll be with, what you'll watch, and where your phone will be.`;

    planText = [
      "My 2027 Reset Plan",
      intro.textContent,
      ...weeks.map((w, i) => `${w.name}: ${extra[i] ? `${w.does} ${extra[i]}` : w.does}`),
      dreadedLine.textContent,
      "Made with tryheal.app/tools/new-year-reset/",
    ].join("\n\n");
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    build();
    plan.hidden = false;
    plan.scrollIntoView({ behavior: "smooth", block: "start" });
    track("built");
  });

  document.getElementById("copy-plan")!.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(planText);
      msg.textContent = "Copied. Paste it into your notes.";
    } catch {
      msg.textContent = "Couldn't copy here. Take a screenshot instead.";
    }
    msg.hidden = false;
    track("copied");
  });
</script>

<style>
  .chip-option span {
    display: inline-block;
    cursor: pointer;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    padding: 0.5rem 1rem;
    color: var(--ink-soft);
  }
  .chip-option input:checked + span {
    background: rgba(164, 139, 247, 0.18);
    border-color: rgba(164, 139, 247, 0.6);
    color: var(--ink);
  }
  .chip-option input:focus-visible + span {
    outline: 2px solid var(--violet-hex);
    outline-offset: 2px;
  }
</style>
