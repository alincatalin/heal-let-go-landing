---
import { ArrowRight, CalendarPlus, Download, RotateCcw, Share2 } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Footer from "../../components/Footer.astro";
import MoreTools from "../../components/MoreTools.astro";
import StoreButtons from "../../components/StoreButtons.astro";
import { appStorePage } from "../../lib/store";

const title = "No Contact Counter: How Many Days of No Contact? | Free";
const description =
  "Free no contact counter: pick the day you last contacted your ex and see which day of no contact you're on, your next milestone and what that day tends to feel like.";

// Milestones the counter tracks. `post` is the closest article in the day series.
const milestones = [
  { day: 1, label: "Day 1", feel: "Raw. The pull to check your phone is constant.", post: "/blog/articles/no-contact-day-1/" },
  { day: 3, label: "Day 3", feel: "Often the loudest urge of the first week.", post: "/blog/articles/hardest-day-no-contact/" },
  { day: 5, label: "Day 5", feel: "A false calm. Easy to talk yourself into one message.", post: "/blog/articles/no-contact-day-5/" },
  { day: 7, label: "1 week", feel: "First real milestone. Evenings are still hard.", post: "/blog/articles/no-contact-day-7/" },
  { day: 10, label: "Day 10", feel: "Double digits, and often the first weekend alone.", post: "/blog/articles/no-contact-day-10/" },
  { day: 14, label: "2 weeks", feel: "Good days appear, then a dip that feels like starting over.", post: "/blog/articles/no-contact-day-14/" },
  { day: 21, label: "3 weeks", feel: "Urges come in waves rather than all day.", post: "/blog/articles/no-contact-day-21/" },
  { day: 30, label: "1 month", feel: "The usual minimum. Time to decide on the next stretch.", post: "/blog/articles/no-contact-day-30/" },
  { day: 60, label: "2 months", feel: "Thoughts of them get shorter and less urgent.", post: "/blog/articles/signs-no-contact-is-working/" },
  { day: 90, label: "3 months", feel: "Your days are mostly yours again. Bad days still come.", post: "/blog/articles/signs-no-contact-is-working/" },
  { day: 180, label: "6 months", feel: "Looking back, you can see how far you came.", post: "/blog/articles/7-stages-of-breakup/" },
  { day: 365, label: "1 year", feel: "A full year of your own dates and seasons.", post: "/blog/articles/7-stages-of-breakup/" },
];

const faq = [
  {
    question: "How do I count days of no contact?",
    answer:
      "Day 1 is the first full day after the last time you contacted them. If you last texted on a Monday, Tuesday is day 1. Contact means anything you start: a text, call, DM, email, comment, or a like or story view on purpose. If they message you and you don't reply, your count keeps going.",
  },
  {
    question: "Does one slip reset no contact?",
    answer:
      "On this counter, yes: you set a new last-contact date and the count starts again. That can feel harsh, so remember the days before still happened. The Heal app handles it differently: a slip restarts your streak but keeps your total days, so you can see the whole picture.",
  },
  {
    question: "How long should no contact last?",
    answer:
      "Thirty days is the common minimum, and 60 to 90 days is better if you're trying to get over them rather than test the waters. If you share children or a workplace, keep contact to logistics only instead of stopping it completely.",
  },
  {
    question: "Is there a free no contact tracker app?",
    answer:
      "Yes. Heal's no contact tracker is free on iPhone and Android and keeps your total days if you slip. It also has an SOS button for the urge to text and a chat where you can write the message without it sending. Several other apps have free trackers too; our no contact app page compares them.",
  },
  {
    question: "Is my date saved anywhere?",
    answer:
      "Only in your own browser, so the count is still there when you come back on this device. Nothing is sent to us. Tap Start over to clear it.",
  },
];

const site = Astro.site!.toString();
const url = new URL("/tools/no-contact-counter/", site).toString();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "No Contact Counter",
    url,
    description,
    applicationCategory: "LifestyleApplication",
    operatingSystem: "Any",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    publisher: { "@type": "Organization", "@id": `${site}#organization`, name: "Heal", url: site },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: site },
      { "@type": "ListItem", position: 2, name: "Free Tools", item: new URL("/tools/", site).toString() },
      { "@type": "ListItem", position: 3, name: "No Contact Counter", item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];

const inputClass =
  "w-full rounded-2xl bg-surface-1 px-4 py-3 text-[16px] text-ink placeholder:text-ink-muted focus:outline-none focus:ring-2 focus:ring-[#a48bf7]/50";
---

<Base
  title={title}
  description={description}
  jsonLd={jsonLd}
  storeSource="tool"
  storeCampaign="no-contact-counter"
  storePage={appStorePage("no-contact")}
>
  <SiteHeader />
  <main class="relative overflow-hidden">
    <div class="mx-auto max-w-[44rem] px-4 py-12 sm:px-6 md:py-16">
      <header class="mb-10 space-y-5 text-center">
        <p class="eyebrow text-lavender">Free · no sign-up · stays on your device</p>
        <h1 class="text-[2.4rem] leading-[1.1] sm:text-5xl">No Contact Counter</h1>
        <p class="lede">
          Pick the last day you contacted your ex. See which day of no contact you're on, your next milestone, and what
          people often feel around now.
        </p>
      </header>

      <form id="counter-form" class="card-raised space-y-5 p-6 md:p-9" novalidate>
        <label class="block space-y-3">
          <span class="text-xl font-semibold text-ink">When did you last contact them?</span>
          <span class="block text-[15px] text-ink-soft">A text, call, DM or comment you started. Their messages don't count.</span>
          <input id="since" name="since" type="date" required class={inputClass} />
        </label>
        <p id="form-error" class="text-sm text-[#f49aa7]" hidden>Pick a date first.</p>
        <button type="submit" class="btn btn-primary w-full justify-center">Count my days <ArrowRight /></button>
      </form>

      <section id="result" class="mt-8 space-y-6" hidden aria-live="polite">
        <div class="card-raised p-6 text-center md:p-9">
          <p id="r-eyebrow" class="eyebrow text-lavender">No contact</p>
          <p class="mt-2 font-display text-[5.5rem] leading-none text-ink" id="r-day">0</p>
          <p id="r-sub" class="mt-2 text-lg text-ink-soft"></p>
          <div class="mx-auto mt-6 h-2 max-w-sm overflow-hidden rounded-full bg-surface-1" aria-hidden="true">
            <div id="r-bar" class="h-full rounded-full bg-[#a48bf7]" style="width:0%"></div>
          </div>
          <p id="r-next" class="mt-3 text-[15px] text-ink-soft"></p>
        </div>

        <div class="card-raised space-y-3 p-6 md:p-8">
          <p class="eyebrow text-lavender">Around now</p>
          <p id="r-feel" class="text-[17px] leading-relaxed text-ink"></p>
          <a id="r-post" href="/blog/articles/no-contact-day-by-day/" class="inline-flex items-center gap-2 font-semibold text-lavender">
            Read what this stretch is like <ArrowRight class="h-4 w-4" />
          </a>
        </div>

        <div class="card-raised p-6 md:p-8">
          <p class="eyebrow text-lavender">Your milestones</p>
          <ol id="r-list" class="mt-4 space-y-2 text-[15px]"></ol>
          <div class="mt-6 flex flex-wrap gap-3">
            <button type="button" id="cal" class="btn btn-quiet"><CalendarPlus /> Add milestones to my calendar</button>
            <button type="button" id="share" class="btn btn-quiet"><Share2 /> Share my count</button>
            <button type="button" id="reset" class="btn btn-quiet"><RotateCcw /> I slipped / start over</button>
          </div>
          <p id="msg" class="mt-3 text-sm text-ink-muted" hidden></p>
        </div>

        <div id="slip" class="card-raised space-y-3 p-6 md:p-8" hidden>
          <p class="eyebrow text-lavender">If you slipped</p>
          <p id="slip-prev" class="text-[17px] font-semibold text-ink"></p>
          <p class="text-[17px] leading-relaxed text-ink-soft">
            One message doesn't erase the days before it. Read <a href="/blog/articles/i-broke-no-contact/" class="text-lavender underline underline-offset-4">what to do after you break no contact</a>,
            then set today's date and start again. Next time the urge hits, write the message in the
            <a href="/tools/unsent-text/" class="text-lavender underline underline-offset-4">unsent text tool</a> first, where it can't send.
          </p>
        </div>

        <canvas id="card" width="1080" height="1920" class="hidden" aria-hidden="true"></canvas>

        <div class="card-raised space-y-4 p-6 md:p-8" data-cta="tool">
          <p class="eyebrow text-lavender">Keep the count on your phone</p>
          <p class="text-[17px] leading-relaxed text-ink-soft">
            This page counts days. The hard part is the minute you want to text them. Heal keeps your count on a
            calendar (a slip restarts the streak but keeps your total), and when the urge hits there's an SOS button
            and a chat that looks like theirs but never sends. Free on iPhone and Android.
          </p>
          <StoreButtons matchDevice />
        </div>
      </section>

      <div class="prose-heal mt-16">
        <h2>What is a no contact counter?</h2>
        <p>
          A no contact counter shows how many days it's been since you last contacted your ex. Day 1 is the first full
          day after your last message, call or comment. Seeing the number helps on days when it feels like nothing has
          changed. This one is free, needs no account, and remembers your date only in your own browser.
        </p>

        <h2>What each no contact milestone tends to feel like</h2>
        <p>Everyone's timeline is different. These are common patterns, not rules.</p>
        <table>
          <thead>
            <tr><th>Milestone</th><th>What it often feels like</th><th>Read more</th></tr>
          </thead>
          <tbody>
            {
              milestones.map((m) => (
                <tr>
                  <td>{m.label}</td>
                  <td>{m.feel}</td>
                  <td><a href={m.post}>Guide</a></td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p>
          Feelings after a breakup don't fade in a straight line. In one study that followed people every day for four
          weeks after a breakup, sadness and anger went down overall but rose and fell from day to day (<a
            href="https://doi.org/10.1111/j.1350-4126.2005.00112.x">Sbarra and Emery, 2005</a>). Brain scans of people
          who had just been rejected showed activity in reward and craving areas, which helps explain why the urge to
          reach out can feel so physical (<a href="https://doi.org/10.1152/jn.00784.2009">Fisher et al., 2010</a>).
          That's what the count is for: proof of progress on days you can't feel it.
        </p>

        <h2>What counts as breaking no contact?</h2>
        <p>
          Anything you start: a text, call, DM, email, comment, or liking and watching their posts on purpose. A reply
          you didn't send doesn't count, and neither does logistics you can't avoid, like co-parenting messages. Our guide
          on <a href="/blog/articles/what-counts-as-breaking-no-contact/">what counts as breaking no contact</a> covers
          the grey areas. For the whole method, read the <a href="/blog/articles/no-contact-rule-guide/">no contact rule guide</a>.
        </p>

        <h2>FAQ: No contact counter</h2>
        {
          faq.map((item) => (
            <>
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </>
          ))
        }

        <h2>Sources</h2>
        <ul>
          <li>Sbarra, D. A., and Emery, R. E. (2005). The emotional sequelae of nonmarital relationship dissolution. <em>Personal Relationships</em>, 12(2), 213 to 232.</li>
          <li>Fisher, H. E., Brown, L. L., Aron, A., Strong, G., and Mashek, D. (2010). Reward, addiction, and emotion regulation systems associated with rejection in love. <em>Journal of Neurophysiology</em>, 104(1), 51 to 60.</li>
        </ul>
        <p class="text-sm text-ink-muted">
          This tool isn't a substitute for professional help. If you're struggling or feel unsafe, visit
          <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer">findahelpline.com</a> to reach a local helpline.
        </p>
      </div>
    </div>
  </main>
  <MoreTools current="/tools/no-contact-counter/" />
  <Footer />
</Base>

<script is:inline type="application/json" id="counter-data" set:html={JSON.stringify({ milestones })} />

<script>
  type Milestone = { day: number; label: string; feel: string; post: string };
  type Umami = { track: (event: string, data?: Record<string, string>) => void };
  const { milestones } = JSON.parse(document.getElementById("counter-data")!.textContent!) as { milestones: Milestone[] };
  const track = (result: string) =>
    (window as unknown as { umami?: Umami }).umami?.track("Tool Completed", { tool: "no-contact-counter", result });

  const KEY = "heal-no-contact-since";
  const store = {
    get: () => {
      try { return localStorage.getItem(KEY) ?? ""; } catch { return ""; }
    },
    set: (v: string) => {
      try { localStorage.setItem(KEY, v); } catch { /* private mode */ }
    },
    clear: () => {
      try { localStorage.removeItem(KEY); } catch { /* private mode */ }
    },
  };

  const form = document.getElementById("counter-form") as HTMLFormElement;
  const since = document.getElementById("since") as HTMLInputElement;
  const error = document.getElementById("form-error")!;
  const result = document.getElementById("result")!;
  const msg = document.getElementById("msg")!;
  const $ = (id: string) => document.getElementById(id)!;

  const todayIso = new Date().toLocaleDateString("en-CA");
  since.max = todayIso;

  const parse = (iso: string) => {
    const [y, m, d] = iso.split("-").map(Number);
    return new Date(y, m - 1, d);
  };
  const today = () => {
    const now = new Date();
    now.setHours(0, 0, 0, 0);
    return now;
  };
  const addDays = (date: Date, n: number) => new Date(date.getFullYear(), date.getMonth(), date.getDate() + n);
  const fmt = (date: Date) => date.toLocaleDateString(undefined, { month: "short", day: "numeric", year: "numeric" });
  const dayOf = (iso: string) => Math.max(0, Math.round((today().getTime() - parse(iso).getTime()) / 86400000));

  let current = 0;

  function render(iso: string) {
    const day = dayOf(iso);
    current = day;
    const start = parse(iso);
    const next = milestones.find((m) => m.day > day);
    const prev = [...milestones].reverse().find((m) => m.day <= day);
    const stage = prev ?? milestones[0];

    $("r-eyebrow").textContent = day === 0 ? "No contact starts today" : "Day of no contact";
    $("r-day").textContent = String(day);
    const weeks = Math.floor(day / 7);
    $("r-sub").textContent =
      day === 0
        ? "Tomorrow is day 1. Tonight is often the hardest part."
        : weeks > 0
          ? `${weeks} ${weeks === 1 ? "week" : "weeks"}${day % 7 ? ` and ${day % 7} ${day % 7 === 1 ? "day" : "days"}` : ""} since you last reached out.`
          : `${day} ${day === 1 ? "day" : "days"} since you last reached out.`;

    if (next) {
      const from = prev?.day ?? 0;
      $("r-bar").style.width = `${Math.max(3, ((day - from) / (next.day - from)) * 100)}%`;
      const left = next.day - day;
      $("r-next").textContent = `${left} ${left === 1 ? "day" : "days"} to ${next.label} (${fmt(addDays(start, next.day))})`;
    } else {
      $("r-bar").style.width = "100%";
      $("r-next").textContent = "More than a year. Every milestone on this page is behind you.";
    }

    $("r-feel").textContent = day === 0 ? milestones[0].feel : stage.feel;
    ($("r-post") as HTMLAnchorElement).href = day === 0 ? milestones[0].post : stage.post;

    const list = $("r-list");
    list.replaceChildren(
      ...milestones.slice(1).map((m) => {
        const li = document.createElement("li");
        const done = m.day <= day;
        li.className = done ? "text-ink-muted" : "text-ink";
        li.textContent = `${done ? "✓" : "○"} ${m.label}: ${fmt(addDays(start, m.day))}`;
        return li;
      }),
    );

    result.hidden = false;
  }

  function ics(iso: string) {
    const start = parse(iso);
    const pad = (n: number) => String(n).padStart(2, "0");
    const ymd = (date: Date) => `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}`;
    const stamp = new Date().toISOString().replace(/[-:]/g, "").replace(/\.\d+/, "");
    const events = milestones
      .filter((m) => m.day > current)
      .flatMap((m) => {
        const d = ymd(addDays(start, m.day));
        return [
          "BEGIN:VEVENT",
          `UID:no-contact-${iso}-${m.day}@tryheal.app`,
          `DTSTAMP:${stamp}`,
          `DTSTART;VALUE=DATE:${d}`,
          `SUMMARY:No contact: ${m.label}`,
          `DESCRIPTION:You made it to ${m.label.toLowerCase()} of no contact. tryheal.app/tools/no-contact-counter/`,
          "END:VEVENT",
        ];
      });
    return ["BEGIN:VCALENDAR", "VERSION:2.0", "PRODID:-//Heal//No Contact Counter//EN", "CALSCALE:GREGORIAN", ...events, "END:VCALENDAR"].join("\r\n");
  }

  async function drawCard() {
    await document.fonts.ready;
    const canvas = $("card") as HTMLCanvasElement;
    const ctx = canvas.getContext("2d")!;
    const W = canvas.width;
    const H = canvas.height;
    const display = '"Fraunces Variable", Georgia, serif';
    const sans = '"Figtree Variable", system-ui, sans-serif';
    const bg = ctx.createLinearGradient(0, 0, W, H);
    bg.addColorStop(0, "#1a1236");
    bg.addColorStop(0.55, "#0c0a16");
    bg.addColorStop(1, "#2a1240");
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);
    const x = 96;
    ctx.fillStyle = "#c4b5fd";
    ctx.font = `600 44px ${sans}`;
    ctx.fillText("NO CONTACT", x, 520);
    ctx.fillStyle = "#f3eef8";
    ctx.font = `600 380px ${display}`;
    ctx.fillText(String(current), x - 10, 900);
    ctx.fillStyle = "#c9c0d6";
    ctx.font = `500 64px ${sans}`;
    ctx.fillText(current === 1 ? "day. Still going." : "days. Still going.", x, 1010);
    ctx.font = `italic 500 60px ${display}`;
    ctx.fillStyle = "#f3eef8";
    ctx.fillText("Not texting them is", x, 1240);
    ctx.fillText("a choice I keep making.", x, 1320);
    ctx.fillStyle = "#a39ab5";
    ctx.font = `500 36px ${sans}`;
    ctx.fillText("Count yours: tryheal.app/tools/no-contact-counter", x, H - 110);
    return new Promise<Blob>((resolve) => canvas.toBlob((b) => resolve(b!), "image/png"));
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!since.value) {
      error.hidden = false;
      since.focus();
      return;
    }
    error.hidden = true;
    store.set(since.value);
    render(since.value);
    result.scrollIntoView({ behavior: "smooth", block: "start" });
    track("counted");
  });

  $("cal").addEventListener("click", () => {
    const link = document.createElement("a");
    link.href = URL.createObjectURL(new Blob([ics(since.value)], { type: "text/calendar" }));
    link.download = "no-contact-milestones.ics";
    link.click();
    URL.revokeObjectURL(link.href);
    msg.textContent = "Open the file to add your milestones to your calendar.";
    msg.hidden = false;
    track("calendar");
  });

  $("share").addEventListener("click", async () => {
    const blob = await drawCard();
    const file = new File([blob], `no-contact-day-${current}.png`, { type: "image/png" });
    try {
      if (navigator.canShare?.({ files: [file] })) {
        await navigator.share({ files: [file], text: `Day ${current} of no contact. tryheal.app/tools/no-contact-counter` });
      } else {
        const link = document.createElement("a");
        link.href = URL.createObjectURL(blob);
        link.download = file.name;
        link.click();
        URL.revokeObjectURL(link.href);
        msg.textContent = "Saved. Add it to your story from your photos.";
        msg.hidden = false;
      }
      track("shared");
    } catch {
      // Closing the share sheet throws; nothing to report.
    }
  });

  $("reset").addEventListener("click", () => {
    if (current > 0) $("slip-prev").textContent = `Your last run was ${current} ${current === 1 ? "day" : "days"}. That still happened.`;
    store.clear();
    since.value = todayIso;
    $("slip").hidden = false;
    render(todayIso);
    store.set(todayIso);
    track("reset");
  });

  // Come back to your count: from ?since= in the link, or from this browser.
  const fromUrl = new URLSearchParams(location.search).get("since") ?? "";
  const saved = /^\d{4}-\d{2}-\d{2}$/.test(fromUrl) ? fromUrl : store.get();
  if (saved && saved <= todayIso) {
    since.value = saved;
    render(saved);
  }
</script>
