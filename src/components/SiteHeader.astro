---
import Logo from "./Logo.astro";
import { APP_STORE_URL } from "../lib/site";
---

<header class="sticky top-0 z-40 border-b border-hairline bg-night/80 backdrop-blur-xl">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <Logo />
    <nav class="flex items-center gap-2 sm:gap-4 text-[15px]" aria-label="Main">
      <a href="/blog/" class="btn btn-quiet h-10">Blog</a>
      <a href={APP_STORE_URL} data-platform="auto" target="_blank" rel="noreferrer" class="btn btn-primary h-10 px-5">Get the app</a>
    </nav>
  </div>
</header>
