---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  screenshot: ImageMetadata;
  alt: string;
  eager?: boolean;
  /** Rendered width in px at the largest size. */
  width?: number;
  class?: string;
  glow?: boolean;
}
const { screenshot, alt, eager = false, width = 300, class: className = "", glow = true } = Astro.props;
---

<figure class:list={["relative mx-auto", className]} style={`width: min(${width}px, 100%);`}>
  {glow && <div class="pointer-events-none absolute -inset-8 -z-10 rounded-[4rem] bg-dusk opacity-30 blur-3xl" aria-hidden="true" />}
  <div class="relative rounded-[2.75rem] bg-surface-3 p-[7px] shadow-elev-3 ring-1 ring-white/10">
    <div class="overflow-hidden rounded-[2.35rem] bg-night ring-1 ring-black/60">
      <Image
        src={screenshot}
        alt={alt}
        widths={[width, width * 2]}
        sizes={`${width}px`}
        class="block h-auto w-full"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : "auto"}
      />
    </div>
  </div>
</figure>
