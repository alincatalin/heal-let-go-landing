---
import Section from "./Section.astro";

const steps = [
  {
    title: "Tell us your story",
    description:
      "When did the breakup happen? When did you last contact them? We personalize everything to your journey.",
  },
  {
    title: "Get support when you need it",
    description:
      "Open the app when you're struggling. Use fake texting to vent. Talk to the AI coach. Journal your feelings.",
  },
  {
    title: "Track your progress",
    description: "Watch your no-contact days grow. Move through the phases of recovery. See yourself getting stronger.",
  },
  {
    title: "Choose yourself, every day",
    description: "Healing isn't linear. Some days are harder than others. We're here for all of them.",
  },
];
---

<Section eyebrow="How it works" title="Four small steps" width="narrow">
  <ol class="relative space-y-4">
    {
      steps.map((step, i) => (
        <li class="card relative flex items-start gap-5 p-5 md:gap-6 md:p-6">
          <span class="relative grid h-11 w-11 shrink-0 place-items-center rounded-full bg-dusk font-display text-xl text-white shadow-glow md:h-12 md:w-12">
            {i + 1}
          </span>
          <div class="space-y-1.5 pt-1">
            <h3 class="font-sans text-lg font-semibold tracking-normal">{step.title}</h3>
            <p class="text-[15px] leading-relaxed text-ink-soft">{step.description}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
