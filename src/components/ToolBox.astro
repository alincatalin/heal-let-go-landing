---
// The free tool under an article: one card, matched to the post's problem, so readers can act on it right away.
import { ArrowRight } from "@lucide/astro";
import type { Tool } from "../lib/tools";

interface Props {
  tool: Tool;
}
const { tool } = Astro.props;
---

<aside class="card-link relative mt-14 rounded-[1.5rem] border border-[#a48bf7]/30 bg-[#a48bf7]/[0.07] p-7" aria-label="Free tool">
  <p class="eyebrow text-lavender">Free tool · {tool.label}</p>
  <p class="mt-3 font-display text-[1.6rem] leading-snug text-ink">
    <a href={tool.href} class="after:absolute after:inset-0 after:rounded-[1.5rem] focus-visible:outline-none">{tool.name}</a>
  </p>
  <p class="mt-3 text-[16px] leading-relaxed text-ink-soft">{tool.blurb}</p>
  <p class="mt-5 inline-flex items-center gap-2 font-semibold text-lavender">
    {tool.cta} <ArrowRight class="h-4 w-4" />
  </p>
</aside>
