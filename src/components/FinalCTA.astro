---
import StoreButtons from "./StoreButtons.astro";

interface Props {
  title?: string;
  text?: string;
  matchDevice?: boolean;
}
const {
  title = "Ready to stop the cycle?",
  text = "Download Heal: Let Them Go and get the support you need when the urge to text hits hardest.",
  matchDevice = false,
} = Astro.props;
---

<section class="relative py-20 md:py-24">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <div class="card-raised relative overflow-hidden px-6 py-14 text-center md:px-16 md:py-20">
      <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(70% 90% at 50% 0%, rgba(109, 59, 216, 0.28) 0%, transparent 70%);" aria-hidden="true"></div>
      <div class="relative space-y-6">
        <h2 class="text-4xl leading-tight md:text-5xl">{title}</h2>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-ink-soft">{text}</p>
        <div class="flex justify-center pt-2">
          <StoreButtons matchDevice={matchDevice} class="sm:justify-center" />
        </div>
      </div>
    </div>
  </div>
</section>
