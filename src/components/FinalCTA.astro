---
import StoreButtons from "./StoreButtons.astro";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Ready to stop the cycle?",
  text = "Download Heal: Let Them Go and get the support you need when the urge to text hits hardest.",
} = Astro.props;
---

<section class="py-20 relative">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <div class="bg-gradient-primary rounded-3xl p-12 md:p-16 text-center space-y-8 relative overflow-hidden shadow-glow-strong">
        <div class="absolute inset-0 bg-gradient-glow opacity-50"></div>
        <div class="relative z-10 space-y-6">
          <h2 class="text-4xl md:text-5xl font-bold">{title}</h2>
          <p class="text-xl text-primary-foreground/90 max-w-2xl mx-auto">{text}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
            <StoreButtons />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
