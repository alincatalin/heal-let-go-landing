---
import { Heart } from "@lucide/astro";
import { SUPPORT_EMAIL } from "../lib/site";
---

<footer class="py-12 border-t border-border">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto space-y-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-6">
        <a href="/" class="flex items-center gap-2">
          <Heart class="w-6 h-6 text-primary" />
          <span class="text-xl font-semibold">Heal: Let them go</span>
        </a>

        <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="Footer">
          <a href="/blog/" class="text-muted-foreground hover:text-primary transition-colors">Blog</a>
          <a href="/privacy/" class="text-muted-foreground hover:text-primary transition-colors">Privacy</a>
          <a href="/terms/" class="text-muted-foreground hover:text-primary transition-colors">Terms</a>
          <a href={`mailto:${SUPPORT_EMAIL}`} class="text-muted-foreground hover:text-primary transition-colors">Email</a>
        </nav>
      </div>

      <div class="text-center space-y-2">
        <p class="text-sm text-muted-foreground">Built by someone who's been exactly where you are</p>
        <p class="text-xs text-muted-foreground">
          Need immediate support? Visit{" "}
          <a href="https://findahelpline.com" target="_blank" rel="noopener noreferrer" class="underline hover:text-primary transition-colors">findahelpline.com</a>{" "}
          to connect with a local helpline.
        </p>
      </div>
    </div>
  </div>
</footer>
