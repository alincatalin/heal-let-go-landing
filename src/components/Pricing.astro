---
import { Check } from "@lucide/astro";
import Section from "./Section.astro";
import StoreButtons from "./StoreButtons.astro";

const freePerks = [
  "No contact tracker and SOS button",
  "5 AI coach messages a day",
  "Private journal and mood tracking",
  "7-day free trial of everything",
];
const paidPerks = ["Unlimited AI coach messages", "Unlimited fake texting", "Streak Protection", "Every healing practice"];
---

<Section id="pricing" eyebrow="Pricing" title="Start free. Stay if it helps.">
  <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-2">
    <div class="card-raised card-selected flex flex-col gap-6 p-8 md:p-10">
      <div class="space-y-3">
        <p class="eyebrow text-lavender">Start free</p>
        <p class="font-display text-6xl font-light leading-none">Free</p>
        <p class="text-[15px] leading-relaxed text-ink-soft">
          Download Heal: No Contact & Breakup free on iOS or Android. The core tools stay free, and you can try everything
          free for 7 days.
        </p>
      </div>
      <ul class="space-y-3 text-[15px]">
        {
          freePerks.map((perk) => (
            <li class="flex items-center gap-3">
              <Check class="h-[18px] w-[18px] text-sage" />
              <span>{perk}</span>
            </li>
          ))
        }
      </ul>
      <div class="mt-auto" data-cta="pricing"><StoreButtons stacked /></div>
    </div>

    <div class="card-raised flex flex-col gap-6 p-8 md:p-10">
      <div class="space-y-3">
        <p class="eyebrow">Heal Premium</p>
        <p class="flex items-baseline gap-2">
          <span class="font-display text-6xl font-light leading-none">$12.99</span>
          <span class="text-ink-muted">/month</span>
        </p>
        <p class="text-[15px] text-ink-soft">Or $124.99 a year. No commitment. Cancel anytime.</p>
      </div>
      <ul class="space-y-3 text-[15px]">
        {
          paidPerks.map((perk) => (
            <li class="flex items-center gap-3">
              <Check class="h-[18px] w-[18px] text-sage" />
              <span>{perk}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-auto rounded-2xl border border-hairline bg-surface-1 px-5 py-4 text-center text-sm text-ink-muted">Upgrade inside the app</p>
    </div>
  </div>
</Section>
