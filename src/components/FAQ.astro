---
import { ChevronDown } from "@lucide/astro";
import Section from "./Section.astro";
import { faqs } from "../lib/faqs";
---

<Section eyebrow="Questions" title="Frequently asked questions" width="narrow">
  <div class="card-raised divide-y divide-hairline overflow-hidden">
    {
      faqs.map((faq) => (
        <details name="faq" class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-left transition-colors hover:bg-white/[0.02] md:px-8">
            <h3 class="font-sans text-[17px] font-semibold tracking-normal text-ink">{faq.question}</h3>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-surface-3 text-ink-muted">
              <ChevronDown class="chevron h-4 w-4 transition-transform duration-200" />
            </span>
          </summary>
          <p class="px-6 pb-6 text-[15px] leading-relaxed text-ink-soft md:px-8">{faq.answer}</p>
        </details>
      ))
    }
  </div>
</Section>
