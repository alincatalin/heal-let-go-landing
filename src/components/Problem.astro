---
import Section from "./Section.astro";

const painPoints = [
  "You've broken no contact more times than you can count",
  "Late nights are the hardest - that's when you're weakest",
  'Everyone says "just move on" but nobody tells you HOW',
  "You're tired of feeling stuck in this pain",
  "You want to heal, but you don't know where to start",
];
---

<Section
  eyebrow="Sound familiar?"
  title={`You know you shouldn't text them. <span class="italic text-lavender">But you can't stop thinking about it.</span>`}
  width="narrow"
>
  <div class="space-y-10 text-center">
    <p class="quote text-2xl leading-relaxed md:text-[1.7rem] text-ink-soft">
      It's 2am. You've had a few drinks. You're scrolling through old photos. Your thumb hovers over their name.
    </p>
    <p class="lede">You know it won't help. You know you'll regret it. But the urge is overwhelming.</p>

    <ul class="card-raised divide-y divide-hairline overflow-hidden text-left">
      {
        painPoints.map((point) => (
          <li class="flex items-start gap-4 px-6 py-5 md:px-8">
            <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-ember shadow-glow-ember" aria-hidden="true" />
            <span class="text-[17px] leading-relaxed text-ink">{point}</span>
          </li>
        ))
      }
    </ul>

    <p class="font-display text-2xl text-ink">You're not weak. You're human. <span class="italic text-lavender">And you deserve support.</span></p>
  </div>
</Section>
