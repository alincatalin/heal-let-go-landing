---
import { Mail, MessageCircle } from "@lucide/astro";
import Section from "./Section.astro";
import { SUPPORT_EMAIL } from "../lib/site";
---

<Section
  eyebrow="We are here for you"
  title="Need to talk to someone on the team?"
  lede="Whether you have product questions, need help getting unstuck, or just want to share feedback, we will get back to you as soon as possible."
>
  <div class="mx-auto grid max-w-4xl gap-5 md:grid-cols-2">
    <div class="card flex flex-col gap-4 p-8">
      <span class="well text-lavender"><Mail class="h-5 w-5" stroke-width={1.75} /></span>
      <h3 class="font-sans text-xl font-semibold tracking-normal">Email support</h3>
      <p class="text-[15px] leading-relaxed text-ink-soft">
        Send us a note at{" "}
        <a href={`mailto:${SUPPORT_EMAIL}`} class="text-lavender underline decoration-lavender/40 underline-offset-4 hover:decoration-lavender">{SUPPORT_EMAIL}</a>{" "}
        and we will respond within 24 hours—usually much faster.
      </p>
      <a href={`mailto:${SUPPORT_EMAIL}`} class="btn btn-secondary mt-auto w-fit">Email the team</a>
    </div>

    <div class="card flex flex-col gap-4 p-8">
      <span class="well text-orchid"><MessageCircle class="h-5 w-5" stroke-width={1.75} /></span>
      <h3 class="font-sans text-xl font-semibold tracking-normal">In-app contact form</h3>
      <p class="text-[15px] leading-relaxed text-ink-soft">
        Tap <span class="font-semibold text-ink">Support → Contact Us</span> in the Heal app to send a message
        without leaving your healing flow. We will follow up right in your inbox.
      </p>
      <ul class="space-y-2 text-sm text-ink-muted">
        <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-muted"></span>Share context about your journey or account</li>
        <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-muted"></span>Attach screenshots of anything that looks off</li>
        <li class="flex gap-2.5"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-muted"></span>Expect a personal response within hours</li>
      </ul>
    </div>
  </div>
</Section>
