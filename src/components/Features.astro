---
import { PenLine, MessageCircle, TrendingUp, BookOpen, Compass, Wind } from "@lucide/astro";
import Section from "./Section.astro";

// Tints follow the app: lavender for tools, orchid for the personal, ember for warmth, sage for progress.
const features = [
  {
    icon: PenLine,
    tint: "text-lavender",
    title: "Fake Texting",
    description:
      "Write the message you want to send your ex - but instead of sending it, our AI talks you through why you want to reach out. Get the relief of venting without the regret of actually texting them.",
  },
  {
    icon: MessageCircle,
    tint: "text-orchid",
    title: "AI Coach (Available 24/7)",
    description:
      "Choose your tone: Supportive, Direct, or Empathetic. Get real-time guidance when you're spiraling. No judgment. No therapist fees. Just help when you need it most.",
  },
  {
    icon: TrendingUp,
    tint: "text-sage",
    title: "No-Contact Tracker",
    description:
      "See how many days you've stayed strong. Celebrate milestones. Understand that every day without contact is a day of choosing yourself.",
  },
  {
    icon: BookOpen,
    tint: "text-ember",
    title: "Private Journal",
    description:
      "Dump your thoughts, track your progress, process your emotions. Your words stay private - never shared, never judged.",
  },
  {
    icon: Compass,
    tint: "text-lavender",
    title: "Your Path, Phase by Phase",
    description:
      "From the first days to moving forward, Heal shows where you are and what's normal right now - so the hard parts make sense.",
  },
  {
    icon: Wind,
    tint: "text-orchid",
    title: "Breathing & Calm",
    description: "When panic hits at 3am, calm your nervous system with guided exercises designed for heartbreak.",
  },
];
---

<Section
  eyebrow="What's inside"
  title={`Meet your <span class="italic text-lavender">24/7 breakup recovery companion</span>`}
  lede="Heal: Let Them Go catches you in your weakest moments and helps you heal instead of hurting yourself more."
>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 md:gap-5">
    {
      features.map((feature) => (
        <div class="card p-7 space-y-4">
          <span class:list={["well", feature.tint]}>
            <feature.icon class="h-5 w-5" stroke-width={1.75} />
          </span>
          <h3 class="font-sans text-lg font-semibold tracking-normal text-ink">{feature.title}</h3>
          <p class="text-[15px] leading-relaxed text-ink-soft">{feature.description}</p>
        </div>
      ))
    }
  </div>
</Section>
