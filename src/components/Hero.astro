---
import { ArrowDown } from "@lucide/astro";
import PhoneMockup from "./PhoneMockup.astro";
import StoreButtons from "./StoreButtons.astro";
import today from "../assets/screens/today.png";
import breathe from "../assets/screens/sos-breathe.png";
---

<section class="relative overflow-hidden" data-cta="hero">
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-4 pb-20 pt-14 sm:px-6 md:pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 lg:pb-28">
    <div class="space-y-8">
      <p class="eyebrow text-lavender">Breakup recovery, for the hard moments</p>
      <h1 class="text-[2.6rem] leading-[1.08] sm:text-6xl lg:text-[3.9rem]">
        <span class="lg:whitespace-nowrap">Stop texting your ex.</span>
        <span class="block italic text-lavender">Start choosing yourself.</span>
      </h1>
      <p class="lede max-w-xl">
        When it's 2am and you're about to text them, write it in Heal instead. It never sends. Then get through the urge
        with an AI coach and a no contact tracker.
      </p>
      <StoreButtons />
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-ink-muted">
        <span>Free to start on iOS and Android</span>
        <a href="#inside" class="inline-flex items-center gap-1.5 font-semibold text-lavender hover:text-ink transition-colors">
          See inside the app <ArrowDown class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="relative mx-auto flex w-full max-w-[460px] justify-center lg:justify-end">
      <PhoneMockup
        screenshot={breathe}
        alt="SOS: a guided breath, 'Pause with me for a minute'"
        width={250}
        glow={false}
        class="!absolute left-0 top-16 hidden rotate-[-6deg] opacity-80 sm:block"
      />
      <PhoneMockup
        screenshot={today}
        alt="Today: days without contact, the next milestone and where you are"
        width={290}
        eager
        class="relative sm:translate-x-16"
      />
    </div>
  </div>
</section>
