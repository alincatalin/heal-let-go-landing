---
import Section from "./Section.astro";

const testimonials = [
  { text: "I was about to text my ex for the 100th time. This app stopped me.", author: "Beta tester" },
  { text: "Finally, something that actually understands what I'm going through at night.", author: "Beta tester" },
  { text: "The fake texting feature saved me from so many regrets.", author: "Beta tester" },
];
---

<Section eyebrow="From people who've been there" title="Real people. Real healing.">
  <div class="grid gap-5 md:grid-cols-3">
    {
      testimonials.map((t) => (
        <figure class="card flex flex-col justify-between gap-8 p-8">
          <blockquote class="quote text-[1.4rem] leading-snug">“{t.text}”</blockquote>
          <figcaption class="eyebrow">{t.author}</figcaption>
        </figure>
      ))
    }
  </div>
</Section>
