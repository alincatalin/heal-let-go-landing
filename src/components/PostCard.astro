---
import { formatDate, readTimeLabel } from "../lib/site";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  readTime: string;
  headingLevel?: "h2" | "h3";
}
const { href, title, excerpt, category, date, readTime, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article class="card card-link relative flex h-full flex-col p-7">
  <p class="eyebrow text-lavender">{category}</p>
  <Heading class="mt-3 text-[1.45rem] leading-snug">
    <a href={href} class="after:absolute after:inset-0 after:rounded-[1.5rem] focus-visible:outline-none">{title}</a>
  </Heading>
  <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{excerpt}</p>
  <p class="mt-auto flex items-center gap-2 pt-6 text-[13px] text-ink-muted">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readTimeLabel(readTime)}</span>
  </p>
</article>
