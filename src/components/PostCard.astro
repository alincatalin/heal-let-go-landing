---
import { Calendar } from "@lucide/astro";
import { formatDate, readTimeLabel } from "../lib/site";

interface Props {
  href: string;
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  readTime: string;
  headingLevel?: "h2" | "h3";
}
const { href, title, excerpt, category, date, readTime, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article class="card h-full bg-card/50 backdrop-blur-sm border-border transition-all duration-300 hover:shadow-glow hover:-translate-y-1 relative">
  <div class="flex flex-col space-y-1.5 p-6">
    <div class="mb-2">
      <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-0.5 text-xs font-semibold text-secondary-foreground">
        {category}
      </span>
    </div>
    <Heading class="text-xl font-semibold leading-snug tracking-tight mb-2">
      <a href={href} class="after:absolute after:inset-0 hover:text-primary transition-colors">{title}</a>
    </Heading>
    <p class="text-base text-muted-foreground">{excerpt}</p>
  </div>
  <div class="p-6 pt-0 flex items-center gap-4 text-sm text-muted-foreground">
    <span class="flex items-center gap-1">
      <Calendar class="w-4 h-4" />
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    </span>
    <span aria-hidden="true">•</span>
    <span>{readTimeLabel(readTime)}</span>
  </div>
</article>
