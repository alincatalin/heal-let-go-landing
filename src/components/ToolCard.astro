---
import { ArrowRight } from "@lucide/astro";
import type { Tool } from "../lib/tools";

interface Props {
  tool: Tool;
  headingLevel?: "h2" | "h3";
}
const { tool, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
---

<article class="card card-link relative flex h-full flex-col p-7">
  <p class="eyebrow text-lavender">Free tool · {tool.label}</p>
  <Heading class="mt-3 text-[1.45rem] leading-snug">
    <a href={tool.href} class="after:absolute after:inset-0 after:rounded-[1.5rem] focus-visible:outline-none">{tool.name}</a>
  </Heading>
  <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{tool.blurb}</p>
  <p class="mt-auto inline-flex items-center gap-2 pt-6 font-semibold text-lavender">
    {tool.cta} <ArrowRight class="h-4 w-4" />
  </p>
</article>
